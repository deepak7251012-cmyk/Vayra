<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#000000">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>VAYRA AI</title>
<style>
:root { --pri: #22e6e0; --sec: #8b7cf6; --bg: #050508; --glass: rgba(20, 20, 35, 0.7); }
* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
html, body { height: 100%; background: var(--bg); color: #e0e0e0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; overflow: hidden; }
body { display: flex; flex-direction: column; height: 100dvh; padding: env(safe-area-inset-top, 12px) 16px env(safe-area-inset-bottom, 12px); }

/* Top Status Bar */
.top { display: flex; justify-content: space-between; font-size: 11px; color: #8899aa; letter-spacing: 0.5px; }
.top b { display: block; font-size: 14px; color: #fff; font-weight: 600; margin-top: 2px; }

/* Header */
h1 { text-align: center; font-weight: 300; letter-spacing: 0.4em; font-size: 24px; margin: 8px 0; background: linear-gradient(90deg, var(--pri), var(--sec)); -webkit-background-clip: text; color: transparent; }

/* Orb Canvas */
#orb-container { flex: 1; position: relative; min-height: 0; display: flex; align-items: center; justify-content: center; }
#orb { width: 100%; height: 100%; max-width: 400px; }
#state { position: absolute; bottom: 10px; font-size: 11px; letter-spacing: 0.2em; color: var(--pri); text-transform: uppercase; animation: pulse 2s infinite; }

/* Chat Log */
#log { height: 35vh; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding: 10px 0; scrollbar-width: none; }
#log::-webkit-scrollbar { display: none; }
.m { padding: 10px 14px; border-radius: 16px; font-size: 14px; line-height: 1.45; max-width: 85%; word-wrap: break-word; backdrop-filter: blur(10px); }
.user { align-self: flex-end; background: rgba(34, 230, 224, 0.15); border: 1px solid rgba(34, 230, 224, 0.3); color: #fff; border-bottom-right-radius: 4px; }
.ai { align-self: flex-start; background: rgba(139, 124, 246, 0.15); border: 1px solid rgba(139, 124, 246, 0.3); color: #fff; border-bottom-left-radius: 4px; }
.sys { align-self: center; color: #ff6b6b; font-size: 11px; background: rgba(255,107,107,0.1); padding: 4px 10px; border-radius: 10px; }

/* Input Bar */
.bar { display: flex; gap: 10px; align-items: center; margin-top: 8px; }
#in { flex: 1; background: var(--glass); border: 1px solid rgba(34, 230, 224, 0.3); border-radius: 24px; color: #fff; padding: 14px 18px; font-size: 15px; outline: none; transition: 0.3s; }
#in:focus { border-color: var(--pri); box-shadow: 0 0 15px rgba(34, 230, 224, 0.2); }
#mic { width: 52px; height: 52px; border-radius: 50%; border: 2px solid var(--sec); background: radial-gradient(circle, #3a7ad0, #1a2a6a); font-size: 22px; color: #fff; display: flex; align-items: center; justify-content: center; transition: 0.3s; box-shadow: 0 0 15px rgba(139, 124, 246, 0.4); }
#mic.on { border-color: var(--pri); background: radial-gradient(circle, #22e6e0, #0a4a4a); box-shadow: 0 0 25px var(--pri); animation: pulse 1s infinite; }

/* Nav */
nav { display: flex; justify-content: space-around; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.1); }
nav button { background: none; border: none; color: #8899aa; font-size: 11px; display: flex; flex-direction: column; gap: 4px; align-items: center; transition: 0.2s; }
nav button:active { color: var(--pri); transform: scale(0.95); }
nav i { font-style: normal; font-size: 20px; }

/* Modals */
.modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); z-index: 99; padding: 20px; flex-direction: column; overflow-y: auto; }
.modal.open { display: flex; animation: slideUp 0.3s ease; }
.mh { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.mh h2 { color: var(--pri); letter-spacing: 0.1em; font-size: 18px; }
.x { background: none; border: 1px solid #f44; color: #f44; border-radius: 50%; width: 36px; height: 36px; font-size: 18px; }
.f { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; font-size: 13px; color: var(--pri); }
.f input, .f select { background: rgba(255,255,255,0.05); border: 1px solid rgba(34, 230, 224, 0.3); border-radius: 10px; padding: 12px; color: #fff; font-size: 15px; outline: none; }
.f.row { flex-direction: row; align-items: center; justify-content: space-between; }
.btn { width: 100%; padding: 14px; margin-top: 10px; background: rgba(34, 230, 224, 0.15); border: 1px solid var(--pri); color: var(--pri); border-radius: 12px; font-size: 15px; font-weight: 600; }
.item { display: flex; justify-content: space-between; align-items: center; padding: 12px; margin-bottom: 8px; border-left: 3px solid var(--pri); background: rgba(255,255,255,0.03); border-radius: 8px; font-size: 13px; }
.item button { background: none; border: none; color: #ff6b6b; font-size: 18px; padding: 5px; }

/* Toast */
#toast { position: fixed; left: 50%; bottom: 100px; transform: translateX(-50%) translateY(20px); background: rgba(10, 20, 30, 0.9); border: 1px solid var(--pri); color: var(--pri); padding: 10px 20px; border-radius: 20px; font-size: 13px; opacity: 0; transition: 0.3s; pointer-events: none; z-index: 100; text-align: center; backdrop-filter: blur(5px); }
#toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
</style>
</head>
<body>

<div class="top">
  <div>BATTERY<b id="bat">--%</b></div>
  <div style="text-align:right">NETWORK<b id="net">--</b></div>
</div>

<h1 id="title">VAYRA</h1>

<div id="orb-container">
  <canvas id="orb"></canvas>
  <div id="state">READY</div>
</div>

<div id="log"></div>

<div class="bar">
  <input id="in" placeholder="Type or tap mic..." autocomplete="off">
  <button id="mic">🎤</button>
</div>

<nav>
  <button onclick="openM('set')"><i>⚙️</i>Settings</button>
  <button onclick="showMem()"><i>🧠</i>Memory</button>
  <button onclick="showRem()"><i>🔔</i>Reminders</button>
  <button onclick="clearChat()"><i>🗑️</i>Clear</button>
</nav>

<!-- Settings Modal -->
<div class="modal" id="set">
  <div class="mh"><h2>SETTINGS</h2><button class="x" onclick="closeM('set')">✕</button></div>
  <div class="f"><label>🔑 OpenRouter API Key</label><input type="password" id="s-key" placeholder="sk-or-v1-..."></div>
  <div class="f row"><label>👁️ Show Key</label><input type="checkbox" onchange="$('s-key').type=this.checked?'text':'password'"></div>
  <div class="f"><label>🤖 AI Model</label><input id="s-model" value="meta-llama/llama-3.3-70b-instruct"></div>
  <div class="f"><label>🔊 Voice Language</label><select id="s-lang"><option value="hi-IN">Hindi / Hinglish</option><option value="en-US">English</option></select></div>
  <div class="f row"><label>🎙️ Auto-Listen after reply</label><input type="checkbox" id="s-auto"></div>
  <button class="btn" onclick="saveCfg()">💾 Save Settings</button>
</div>

<!-- Info Modal (Memory/Reminders) -->
<div class="modal" id="info">
  <div class="mh"><h2 id="it">INFO</h2><button class="x" onclick="closeM('info')">✕</button></div>
  <div id="ib"></div>
</div>

<div id="toast"></div>

<script>
const $ = id => document.getElementById(id);
const store = {
  get: (k, d) => { try { return JSON.parse(localStorage.getItem(k)) ?? d } catch { return d } },
  set: (k, v) => localStorage.setItem(k, JSON.stringify(v))
};

let cfg = Object.assign({ key: '', name: 'VAYRA', model: 'meta-llama/llama-3.3-70b-instruct', lang: 'hi-IN', auto: false }, store.get('v_cfg', {}));
let mem = store.get('v_mem', []), hist = store.get('v_hist', []), rem = store.get('v_rem', []);
let state = 'idle', emotion = 'calm', rec = null;

// --- Haptic & Utility ---
function vibrate(ms = 30) { if (navigator.vibrate) navigator.vibrate(ms); }
function toast(t) { const e = $('toast'); e.textContent = t; e.classList.add('show'); setTimeout(() => e.classList.remove('show'), 2500); }
function openM(id) { 
  if (id === 'set') { $('s-key').value = cfg.key; $('s-model').value = cfg.model; $('s-lang').value = cfg.lang; $('s-auto').checked = cfg.auto; }
  $(id).classList.add('open'); vibrate(20); 
}
function closeM(id) { $(id).classList.remove('open'); vibrate(20); }
function saveCfg() { 
  cfg = { key: $('s-key').value.trim(), name: $('s-name')?.value.trim() || 'VAYRA', model: $('s-model').value.trim(), lang: $('s-lang').value, auto: $('s-auto').checked }; 
  store.set('v_cfg', cfg); $('title').textContent = cfg.name.toUpperCase(); toast('Settings Saved! ✨'); closeM('set'); 
}
$('title').textContent = cfg.name.toUpperCase();

// --- System Status ---
if (navigator.getBattery) navigator.getBattery().then(b => { const u = () => $('bat').textContent = Math.round(b.level * 100) + '%'; u(); b.onlevelchange = u; });
$('net').textContent = navigator.onLine ? (navigator.connection?.effectiveType?.toUpperCase() || 'ONLINE') : 'OFFLINE';
window.addEventListener('online', () => $('net').textContent = 'ONLINE');
window.addEventListener('offline', () => $('net').textContent = 'OFFLINE');

// --- Chat Log ---
function addLog(cls, text) { 
  const d = document.createElement('div'); d.className = 'm ' + cls; d.textContent = text; 
  $('log').append(d); 
  while ($('log').children.length > 40) $('log').firstChild.remove(); 
  $('log').scrollTop = 1e9; 
}
hist.forEach(h => addLog(h.role === 'user' ? 'user' : 'ai', h.content));
function clearChat() { hist = []; store.set('v_hist', hist); $('log').innerHTML = ''; toast('Chat Cleared'); vibrate(50); }

function setState(s) { 
  state = s; 
  $('state').textContent = s.toUpperCase(); 
  $('mic').classList.toggle('on', s === 'listening'); 
}

// --- Smart Local Commands (Jarvis-like instant actions) ---
function checkLocalCommand(text) {
  const t = text.toLowerCase();
  if (t.includes('vibrate') || t.includes('kampao')) { vibrate(200); return "Vibration activated! 📳"; }
  if (t.includes('clear chat') || t.includes('chat saaf')) { clearChat(); return "Chat saaf kar diya gaya hai."; }
  if (t.includes('battery')) return `Aapki battery abhi ${$('bat').textContent} hai.`;
  if (t.includes('time') || t.includes('samay')) return `Abhi samay hai ${new Date().toLocaleTimeString('hi-IN')}.`;
  return null; // Return null if not a local command, proceed to AI
}

// --- AI Engine ---
async function ask(text) {
  text = text.trim(); if (!text) return;
  addLog('user', text);
  $('in').value = '';
  
  // 1. Check Local Commands First (Instant, No API cost)
  const localReply = checkLocalCommand(text);
  if (localReply) { addLog('ai', localReply); speak(localReply); return; }

  // 2. API Call
  if (!cfg.key) { toast('Pehle Settings mein API Key daalein'); openM('set'); return; }
  setState('thinking');
  hist.push({ role: 'user', content: text }); hist = hist.slice(-15); // Keep last 15 for context
  
  const sys = `You are ${cfg.name}, a highly intelligent, proactive, and caring personal AI assistant (like Jarvis). 
  Talk in natural, friendly Hinglish. Keep replies concise (2-4 sentences max). 
  Current Time: ${new Date().toString()}. User Facts: ${mem.slice(-10).join('; ') || 'None'}.
  Reply ONLY in valid JSON format: {"reply": "your response", "emotion": "happy|sad|angry|calm", "remember": "short fact to remember or null", "reminder": {"minutes": number, "text": "string"} or null}`;

  try {
    const r = await fetch('https://openrouter.ai/api/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + cfg.key, 'HTTP-Referer': window.location.href },
      body: JSON.stringify({ model: cfg.model, messages: [{ role: 'system', content: sys }, ...hist] })
    });
    const d = await r.json();
    if (!d.choices) throw new Error(d.error?.message || 'API Error');
    
    const raw = d.choices[0].message.content;
    let o;
    try { o = JSON.parse(raw.match(/\{[\s\S]*\}/)[0]); } catch { o = { reply: raw }; }
    
    const reply = String(o.reply || raw);
    if (['happy', 'sad', 'angry', 'calm'].includes(o.emotion)) emotion = o.emotion;
    
    if (o.remember && !mem.includes(o.remember)) { 
      mem.push(String(o.remember)); mem = mem.slice(-50); store.set('v_mem', mem); 
    }
    if (o.reminder && +o.reminder.minutes > 0) addReminder(+o.reminder.minutes, String(o.reminder.text || 'Yaad dilana'));
    
    hist.push({ role: 'assistant', content: reply }); hist = hist.slice(-15); store.set('v_hist', hist);
    addLog('ai', reply); speak(reply);
  } catch (e) { 
    setState('idle'); addLog('sys', 'Error: ' + e.message); 
  }
}

$('in').addEventListener('keydown', e => { if (e.key === 'Enter') { vibrate(20); ask($('in').value); } });

// --- Voice Engine (Mobile Optimized) ---
function speak(t) {
  if (!('speechSynthesis' in window)) { setState('idle'); return; }
  speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(t); u.lang = cfg.lang;
  const v = speechSynthesis.getVoices().find(v => v.lang.startsWith(cfg.lang.split('-')[0])); if (v) u.voice = v;
  u.rate = 1.0; u.pitch = 1.0;
  u.onstart = () => setState('speaking');
  u.onend = u.onerror = () => { setState('idle'); if (cfg.auto) setTimeout(listen, 500); };
  speechSynthesis.speak(u);
}

function listen() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) return toast('Voice support nahi hai is browser mein');
  speechSynthesis.cancel();
  try { rec && rec.abort(); } catch {}
  
  rec = new SR(); rec.lang = cfg.lang; rec.interimResults = false; rec.maxAlternatives = 1;
  rec.onstart = () => { setState('listening'); vibrate(40); };
  rec.onresult = e => { const text = e.results[0][0].transcript; $('in').value = text; ask(text); };
  rec.onerror = e => { setState('idle'); if(e.error !== 'no-speech') toast('Mic Error: ' + e.error); };
  rec.onend = () => { if (state === 'listening') setState('idle'); };
  
  // Mobile requires strict user gesture, which is handled by the button click
  rec.start();
}

$('mic').onclick = () => {
  vibrate(30);
  if (state === 'listening') { rec.stop(); } 
  else if (state === 'speaking') { speechSynthesis.cancel(); setState('idle'); } 
  else { listen(); }
};

// --- Memory & Reminders ---
function showList(title, arr, del) {
  $('it').textContent = title; const b = $('ib'); b.innerHTML = '';
  if (!arr.length) b.innerHTML = '<div style="text-align:center;color:#666;padding:20px;">Kuch nahi hai...</div>';
  arr.forEach((x, i) => { 
    const d = document.createElement('div'); d.className = 'item'; 
    const s = document.createElement('span'); s.textContent = x.text || x; 
    const bt = document.createElement('button'); bt.innerHTML = '✕'; bt.onclick = () => { del(i); showList(title, arr, del); vibrate(20); }; 
    d.append(s, bt); b.append(d); 
  });
  openM('info');
}
function showMem() { showList('MEMORY', mem, i => { mem.splice(i, 1); store.set('v_mem', mem); }); }
function showRem() { showList('REMINDERS', rem.map(r => ({ text: new Date(r.at).toLocaleTimeString('hi-IN', {hour:'2-digit', minute:'2-digit'}) + ' — ' + r.text })), i => { rem.splice(i, 1); store.set('v_rem', rem); }); }

function addReminder(min, text) {
  const r = { id: Date.now() + Math.random(), at: Date.now() + min * 60000, text };
  rem.push(r); store.set('v_rem', rem); schedule(r);
  if ('Notification' in window && Notification.permission === 'default') Notification.requestPermission();
  toast(`Reminder set: ${min} min baad`);
}

function schedule(r) {
  setTimeout(() => {
    if (!rem.some(x => x.id === r.id)) return;
    rem = rem.filter(x => x.id !== r.id); store.set('v_rem', rem);
    const t = 'Yaad dilana: ' + r.text; addLog('ai', t); speak(t); vibrate([100, 50, 100]);
    if ('Notification' in window && Notification.permission === 'granted') new Notification(cfg.name, { body: r.text });
  }, Math.max(r.at - Date.now(), 0));
}
rem.forEach(schedule);

// --- Lightweight Jarvis Orb Animation ---
const cv = $('orb'), ctx = cv.getContext('2d');
let W, H, D = Math.min(window.devicePixelRatio || 1, 2); // Cap at 2 for mobile battery saving
function resize() { W = cv.clientWidth; H = cv.clientHeight; cv.width = W * D; cv.height = H * D; ctx.setTransform(D, 0, 0, D, 0, 0); }
window.addEventListener('resize', resize); resize();

const EMO = { happy: [34, 230, 224], sad: [90, 140, 255], angry: [255, 80, 80], calm: [139, 124, 246] };
let col = [...EMO.calm], level = 0, t = 0;
const N = 600, pts = []; // Reduced particles for mobile performance
for (let i = 0; i < N; i++) {
  const y = 1 - 2 * (i + .5) / N, r = Math.sqrt(1 - y * y), a = i * 2.399963;
  pts.push({ x: Math.cos(a) * r, y, z: Math.sin(a) * r, s: Math.random() * 6.28, p: Math.random() > 0.7 });
}

function ring(cx, cy, r, w, c, rot, dash, gap, al) {
  ctx.save(); ctx.translate(cx, cy); ctx.rotate(rot); ctx.strokeStyle = c; ctx.globalAlpha = al;
  ctx.lineWidth = w; ctx.setLineDash([dash, gap]); ctx.shadowColor = c; ctx.shadowBlur = 8;
  ctx.beginPath(); ctx.arc(0, 0, r, 0, 6.2832); ctx.stroke(); ctx.restore();
}

function frame() {
  t += 0.016;
  const tg = EMO[emotion]; for (let i = 0; i < 3; i++) col[i] += (tg[i] - col[i]) * 0.05;
  const C = `rgb(${col[0] | 0},${col[1] | 0},${col[2] | 0})`;
  
  let target = 0;
  if (state === 'speaking') target = 0.35 + 0.65 * Math.abs(Math.sin(t * 9) * Math.sin(t * 5.3 + 1));
  else if (state === 'listening') target = 0.2 + 0.15 * Math.sin(t * 4);
  else if (state === 'thinking') target = 0.15;
  level += (target - level) * 0.15;
  
  const boost = (state === 'thinking' ? 3 : 1) + level * 2.5;
  ctx.clearRect(0, 0, W, H);
  
  const cx = W / 2, cy = H / 2, R = Math.min(W, H) * 0.28;
  const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, R * 1.4);
  g.addColorStop(0, `rgba(${col[0] | 0},${col[1] | 0},${col[2] | 0},${0.12 + level * 0.3})`); g.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
  
  ring(cx, cy, R * 1.6, 2, C, 0, 2000, 0, 0.8);
  ring(cx, cy, R * 1.45, 1.5, C, t * 0.3 * boost, 3, 9, 0.7);
  ring(cx, cy, R * 1.3, 2, '#3b82f6', -t * 0.4 * boost, 260, 40, 0.9);
  ring(cx, cy, R * 1.15, 1.5, '#8b7cf6', t * 0.6 * boost, 160, 60, 0.9);
  ring(cx, cy, R * 0.6 + level * 8, 3, C, t * 1.2 * boost, 90, 50, 0.95);
  
  const ry = t * 0.35 * (1 + level * 2), cs = Math.cos(ry), sn = Math.sin(ry);
  ctx.shadowBlur = 0; ctx.setLineDash([]);
  for (const p of pts) {
    const wob = 1 + level * 0.22 * Math.sin(t * 8 + p.s * 3);
    const x = (p.x * cs + p.z * sn) * wob, y = p.y * wob, z = (-p.x * sn + p.z * cs) * wob;
    const k = (z + 1) / 2; ctx.globalAlpha = 0.25 + k * 0.75; ctx.fillStyle = p.p ? '#8b7cf6' : C;
    ctx.beginPath(); ctx.arc(cx + x * R, cy + y * R, 0.6 + k * 1.3 + level * 0.8, 0, 6.2832); ctx.fill();
  }
  ctx.globalAlpha = 1; requestAnimationFrame(frame);
}
frame();

// Init Voices
if ('speechSynthesis' in window) speechSynthesis.onvoiceschanged = () => speechSynthesis.getVoices();
</script>
</body>
</html>
