<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Surprise for Rasmalai 💖</title>
<style>
    /* पूरी स्क्रीन का रंग (Dark Purple Romance) */
    body {
        margin: 0; padding: 0; 
        background: radial-gradient(circle at center, #2a0e4a 0%, #0d021a 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
        overflow: hidden;
        display: flex; justify-content: center; align-items: center;
        height: 100vh; color: white; text-align: center;
    }

    /* पहली स्क्रीन (लॉक स्क्रीन) */
    #lock-screen {
        z-index: 10; background: rgba(255, 105, 180, 0.1);
        padding: 40px 20px; border-radius: 20px; backdrop-filter: blur(10px);
        border: 2px solid #ff69b4; box-shadow: 0 0 40px rgba(255, 105, 180, 0.4);
        transition: opacity 0.5s ease;
    }
    
    h2 { color: #ff69b4; font-size: 24px; margin-bottom: 10px; }
    p { color: #dcdcdc; font-size: 14px; }
    
    input {
        padding: 12px; font-size: 20px; border-radius: 10px;
        border: 2px solid #ff69b4; background: rgba(0,0,0,0.5);
        color: white; text-align: center; outline: none;
        letter-spacing: 5px; text-transform: uppercase; width: 100px;
        margin-top: 15px;
    }

    button {
        padding: 12px 25px; font-size: 18px; border-radius: 10px;
        border: none; background: #ff69b4; color: white;
        font-weight: bold; cursor: pointer; margin-left: 10px;
        transition: 0.3s; box-shadow: 0 0 15px #ff69b4;
    }
    button:hover { background: #ff1493; transform: scale(1.05); }

    /* दूसरी स्क्रीन (सरप्राइज वाली) */
    #surprise-screen {
        display: none; position: absolute; width: 100%; height: 100%;
        justify-content: flex-start; align-items: center; flex-direction: column;
        padding-top: 30px; box-sizing: border-box;
    }

    /* हैप्पी बर्थडे टेक्स्ट */
    .birthday-text {
        font-size: 2.2em; font-weight: 900; margin-bottom: 20px;
        background: linear-gradient(45deg, #ff69b4, #ff1493, #ffd700, #ff69b4);
        background-size: 300% 300%;
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        animation: shine 3s infinite linear;
        z-index: 5; text-shadow: 0 0 20px rgba(255,105,180,0.5);
    }
    @keyframes shine { to { background-position: 300% center; } }

    /* फोटो का डिब्बा */
    .photo-container {
        width: 85%; max-width: 320px; height: 350px;
        border-radius: 20px; overflow: hidden;
        border: 3px solid #ff69b4; box-shadow: 0 0 25px #ff69b4;
        margin-bottom: 20px; z-index: 5;
        position: relative; background: #000;
    }
    .photo-container img {
        width: 100%; height: 100%; object-fit: cover;
        position: absolute; top: 0; left: 0;
        opacity: 0; transition: opacity 1s ease-in-out;
    }
    .photo-container img.active { opacity: 1; }

    /* टाइपिंग मैसेज बॉक्स */
    .message-box {
        width: 85%; max-width: 350px; background: rgba(0, 0, 0, 0.7);
        padding: 20px; border-radius: 15px; border: 1px solid #ff69b4;
        font-size: 16px; line-height: 1.6; z-index: 5;
        min-height: 100px; text-align: left;
        box-shadow: 0 0 15px rgba(255, 105, 180, 0.2);
    }
    .message-box p { margin: 0; color: #ffebf5; }

    /* गिरते हुए इमोजी */
    .falling-emoji {
        position: absolute; top: -50px; font-size: 30px;
        animation: fall linear forwards; z-index: 1;
    }
    @keyframes fall { to { transform: translateY(110vh) rotate(360deg); } }
</style>
</head>
<body>

    <!-- 🎵 गाने के लिए (यहाँ तुम्हारे गाने का नाम डालना है) -->
    <audio id="bg-music" loop>
        <!-- नीचे अपने गाने का लिंक डालो, जैसे: src="song.mp3" -->
        <source src="" type="audio/mpeg">
    </audio>

    <!-- पहली स्क्रीन: कोड डालने के लिए -->
    <div id="lock-screen">
        <h2>Secret Code 🔐</h2>
        <p>मेरी रसमलाई के लिए एक सरप्राइज है 😉</p>
        <br>
        <input type="text" id="passcode" placeholder="Code" maxlength="4">
        <button onclick="checkCode()">Unlock</button>
    </div>

    <!-- दूसरी स्क्रीन: सरप्राइज -->
    <div id="surprise-screen">
        <h1 class="birthday-text">Happy Birthday 💖</h1>
        
        <!-- 📸 फोटो स्लाइडर (यहाँ फोटो के लिंक डालो) -->
        <div class="photo-container">
            <!-- फोटो 1 -->
            <img src="https://images.unsplash.com/photo-1518199266791-5375a83190b7?q=80&w=300&auto=format&fit=crop" class="active" alt="Photo 1">
            <!-- फोटो 2 -->
            <img src="https://images.unsplash.com/photo-1522673607200-164d1b6ce486?q=80&w=300&auto=format&fit=crop" alt="Photo 2">
            <!-- फोटो 3 -->
            <img src="https://images.unsplash.com/photo-1494774157365-9e04c6720e47?q=80&w=300&auto=format&fit=crop" alt="Photo 3">
        </div>

        <!-- टाइपिंग मैसेज -->
        <div class="message-box">
            <p id="typing-text"></p>
        </div>
    </div>

    <script>
        const SECRET_CODE = "RAS"; // तुम्हारा कोड
        let isUnlocked = false;

        function checkCode() {
            const userCode = document.getElementById('passcode').value.toUpperCase();
            
            if (userCode === SECRET_CODE) {
                document.getElementById('lock-screen').style.display = 'none';
                document.getElementById('surprise-screen').style.display = 'flex';
                isUnlocked = true;
                
                // गाना चलाओ
                const music = document.getElementById('bg-music');
                if(music.querySelector('source').src !== "") {
                    music.play();
                }

                startRain(); // दिल बरसाओ
                startPhotoSlider(); // फोटो बदलो
                typeWriter(); // प्यारा मैसेज लिखो
            } else {
                alert("Oops! Galat Code. Phir se koshish karo 😜");
            }
        }

        // इमोजी बरसाने का फंक्शन
        function startRain() {
            const emojis = ['❤️', '💖', '🌹', '✨', '💕', '🎂', '💘'];
            setInterval(() => {
                if(!isUnlocked) return;
                const emoji = document.createElement('div');
                emoji.classList.add('falling-emoji');
                emoji.innerText = emojis[Math.floor(Math.random() * emojis.length)];
                emoji.style.left = Math.random() * 100 + 'vw';
                emoji.style.animationDuration = (Math.random() * 2 + 2) + 's';
                emoji.style.fontSize = (Math.random() * 20 + 20) + 'px';
                document.body.appendChild(emoji);
                setTimeout(() => { emoji.remove(); }, 5000);
            }, 200);
        }

        // फोटो बदलने का फंक्शन
        let currentImg = 0;
        function startPhotoSlider() {
            const images = document.querySelectorAll('.photo-container img');
            setInterval(() => {
                if(!isUnlocked) return;
                images[currentImg].classList.remove('active');
                currentImg = (currentImg + 1) % images.length;
                images[currentImg].classList.add('active');
            }, 3000); 
        }

        // टाइपिंग मैसेज
        const message = "Meri pyari Rasmalai, tumhare saath bitaya har pal meri zindagi ka sabse pyara hissa hai. Aaj tumhara din hai, aur main chahta hoon ki tum hamesha muskurati raho. Happy Birthday meri jaan... I love you! ❤️";
        let charIndex = 0;

        function typeWriter() {
            if (charIndex < message.length) {
                document.getElementById('typing-text').innerHTML += message.charAt(charIndex);
                charIndex++;
                setTimeout(typeWriter, 50); 
            }
        }
    </script>
</body>
</html>
